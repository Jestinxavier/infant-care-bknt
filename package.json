{
  "name": "online-shopping-backend",
  "version": "1.0.0",
  "description": "A scalable Node.js backend with JWT authentication",
  "main": "src/server.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration",
    "create-admin": "node scripts/createAdmin.js",
    "seed-categories": "node scripts/seedCategories.js",
    "seed:header": "node scripts/seedHeaderMenu.js",
    "seed:partners": "node scripts/seedDeliveryPartners.js",
    "seed:chat-kb": "node scripts/seed_chat_knowledge.js",
    "migrate:media": "node src/scripts/migrate-to-media-server.js",
    "migrate:media:dry": "node src/scripts/migrate-to-media-server.js --dry-run",
    "migrate:cms-about": "node scripts/migrate-cms-about.js",
    "migrate:cms-about:dry": "node scripts/migrate-cms-about.js --dry-run",
    "migrate:cms-faq": "node scripts/migrate-cms-faq.js",
    "migrate:cms-faq:dry": "node scripts/migrate-cms-faq.js --dry-run",
    "migrate:cms-policies": "node scripts/migrate-cms-policies.js",
    "migrate:cms-policies:dry": "node scripts/migrate-cms-policies.js --dry-run",
    "migrate:cms-links": "node scripts/strip-cms-link-domains.js --write",
    "migrate:cms-links:dry": "node scripts/strip-cms-link-domains.js",
    "fix:media-url": "node src/scripts/fix-media-base-url.js",
    "export:new-products-csv": "node src/scripts/export-new-products-csv.js",
    "backfill:synonyms": "node scripts/backfill_attribute_synonyms.js",
    "review:values": "node scripts/review-attribute-values.js",
    "review:values:backfill": "node scripts/backfill-needs-review.js",
    "normalize:attributes": "node scripts/normalize-attribute-labels.js",
    "normalize:attributes:apply": "node scripts/normalize-attribute-labels.js --apply",
    "normalize:variant-names": "node scripts/normalize-variant-names.js",
    "normalize:variant-names:apply": "node scripts/normalize-variant-names.js --apply",
    "audit:variant-labels": "node scripts/audit-variant-labels.js",
    "fix:letter-size-values": "node scripts/fix-letter-size-values.js",
    "fix:letter-size-values:apply": "node scripts/fix-letter-size-values.js --apply",
    "recount:attribute-usage": "node scripts/recount-attribute-usage.js",
    "recount:attribute-usage:apply": "node scripts/recount-attribute-usage.js --apply",
    "purge:error-logs": "node scripts/purgeNoiseErrorLogs.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "jwt",
    "mongodb",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^2.32.0",
    "@sentry/node": "^10.78.0",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.4",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "meilisearch": "^0.60.0",
    "mongodb": "^6.22.0",
    "mongoose": "^8.24.10",
    "multer": "2.5.0",
    "nanoid": "^3.3.20",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "openapi-types": "^7.2.3",
    "pg-sdk-node": "^2.0.2",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
